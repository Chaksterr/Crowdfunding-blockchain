{
  "name": "plateforme-crowdfunding-blockchain",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy": "HARDHAT_IGNITION_CONFIRM_DEPLOYMENT=1 hardhat ignition deploy ignition/modules/Crowdfunding.js --network localhost",
    "deploy:reset": "HARDHAT_IGNITION_CONFIRM_DEPLOYMENT=1 HARDHAT_IGNITION_CONFIRM_RESET=1 hardhat ignition deploy ignition/modules/Crowdfunding.js --network localhost --reset",
    "sync": "node scripts/syncAbi.js",
    "ff": "hardhat run scripts/fastForward.js --network localhost",
    "simulate": "hardhat run scripts/simulate.js --network localhost",
    "seed": "hardhat run scripts/seedDemo.js --network localhost",
    "e2e": "hardhat compile --quiet && playwright test -c e2e --grep-invert @captures",
    "e2e:captures": "hardhat compile --quiet && playwright test -c e2e --grep @captures",
    "precommit": "bash scripts/precommit.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@playwright/test": "1.64.1",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.0"
  }
}
